{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Kit: Install Harness",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/packages/harness/bin/harness.mjs",
        "install",
        "--configure-vscode",
        "--autonomy",
        "balanced"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev Kit: Upgrade Harness",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/packages/harness/bin/harness.mjs", "upgrade", "--configure-vscode"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev Kit: Harness Doctor",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/packages/harness/bin/harness.mjs", "doctor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
