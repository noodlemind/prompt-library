{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineer-zero-provider-daytona-evidence.v1",
  "title": "Owner-retained zero-provider Daytona runtime evidence",
  "description": "A full runtime evidence envelope retained by a trusted local owner. Its hashes provide content integrity and identity only; they do not authenticate an untrusted operator.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 4,
  "required": [
    "schema", "operatorTrustModel", "artifactHashSemantics", "runtimeRun"
  ],
  "properties": {
    "schema": { "const": "engineer-zero-provider-daytona-evidence.v1" },
    "operatorTrustModel": {
      "const": "trusted-local-owner",
      "description": "The current-user owner and their local launcher are trusted; this envelope does not authenticate evidence against that owner."
    },
    "artifactHashSemantics": {
      "const": "canonical-content-integrity-only",
      "description": "runtimeRun.artifactHash is a canonical content digest, not a signature or proof of operator identity."
    },
    "runtimeRun": { "$ref": "#/$defs/runtimeRun" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeRun": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 10,
      "required": [
        "schema", "executionMode", "evidenceClass", "releaseEligible",
        "authenticationScope", "standaloneSignatureVerifiable", "report",
        "protocolEvidence", "lifecycleHash", "artifactHash"
      ],
      "properties": {
        "schema": { "const": "engineer-zero-provider-daytona-run.v1" },
        "executionMode": { "const": "zero-provider-canary" },
        "evidenceClass": { "const": "infrastructure-validation" },
        "releaseEligible": { "const": false },
        "authenticationScope": { "const": "in-process-hmac-validated" },
        "standaloneSignatureVerifiable": { "const": false },
        "report": { "$ref": "runtime-zero-provider-gate.v1.schema.json" },
        "protocolEvidence": { "$ref": "#/$defs/protocolEvidence" },
        "lifecycleHash": { "$ref": "#/$defs/hash" },
        "artifactHash": {
          "$ref": "#/$defs/hash",
          "description": "Canonical content-integrity digest only; not an operator-authentication signature."
        }
      }
    },
    "protocolEvidence": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 3,
      "required": ["schema", "sessionFinalAttestation", "trials"],
      "properties": {
        "schema": { "const": "engineer-zero-provider-daytona-protocol-evidence.v1" },
        "sessionFinalAttestation": {
          "$ref": "runtime-session-final-attestation.v1.schema.json"
        },
        "trials": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/genericProtocolTrial" },
            { "$ref": "#/$defs/harnessProtocolTrial" }
          ],
          "items": false
        }
      }
    },
    "protocolTrial": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 7,
      "required": [
        "condition", "runtimeRequest", "readinessLease", "outputArchiveReceipt",
        "trialAttestation", "deletionReceipt", "chainEntry"
      ],
      "properties": {
        "condition": { "enum": ["generic", "harness"] },
        "runtimeRequest": { "$ref": "runtime-trial-request.v1.schema.json" },
        "readinessLease": { "$ref": "runtime-readiness-lease.v1.schema.json" },
        "outputArchiveReceipt": { "$ref": "#/$defs/outputArchiveReceipt" },
        "trialAttestation": { "$ref": "runtime-trial-final-attestation.v1.schema.json" },
        "deletionReceipt": {
          "$ref": "runtime-session-final-attestation.v1.schema.json#/$defs/deletionReceipt"
        },
        "chainEntry": {
          "$ref": "runtime-session-final-attestation.v1.schema.json#/$defs/trialChainEntry"
        }
      }
    },
    "genericProtocolTrial": {
      "allOf": [
        { "$ref": "#/$defs/protocolTrial" },
        { "properties": { "condition": { "const": "generic" } } }
      ]
    },
    "harnessProtocolTrial": {
      "allOf": [
        { "$ref": "#/$defs/protocolTrial" },
        { "properties": { "condition": { "const": "harness" } } }
      ]
    },
    "outputArchiveReceipt": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 2,
      "required": ["sha256", "byteLength"],
      "properties": {
        "sha256": { "$ref": "#/$defs/hash" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
      }
    }
  }
}
