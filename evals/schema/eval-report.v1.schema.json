{
  "$id": "eval-report.v1",
  "title": "One release evaluation report (the Eval Card's data)",
  "type": "object",
  "required": ["schema", "harnessVersion", "releaseSha", "task", "calibrationRelease", "deterministic", "pairs", "smokes", "budget", "gate"],
  "properties": {
    "schema": { "const": "eval-report.v1" },
    "harnessVersion": { "type": "string" },
    "releaseSha": { "type": "string" },
    "task": {
      "type": "object",
      "required": ["datasetRef", "task"],
      "properties": {
        "datasetRef": { "type": "string" },
        "task": { "type": "string" },
        "taskChecksum": { "type": ["string", "null"] },
        "taskSet": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task"],
            "properties": {
              "task": { "type": "string" },
              "taskChecksum": { "type": ["string", "null"] },
              "role": { "type": ["string", "null"] },
              "sandbox": { "type": ["object", "null"] }
            }
          }
        },
        "requiredTaskSet": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task"],
            "properties": {
              "task": { "type": "string" },
              "taskChecksum": { "type": ["string", "null"] },
              "role": { "type": ["string", "null"] },
              "sandbox": { "type": ["object", "null"] }
            }
          }
        }
      }
    },
    "evaluationScope": {
      "type": "object",
      "required": ["mode", "releaseEligible", "selectedTasks", "requiredTasks"],
      "properties": {
        "mode": { "enum": ["release", "calibration", "diagnostic-task", "diagnostic-lock", "diagnostic-trust", "deterministic-only"] },
        "releaseEligible": { "type": "boolean" },
        "selectedTasks": { "type": "array", "items": { "type": "string" } },
        "requiredTasks": { "type": "array", "items": { "type": "string" } },
        "trust": { "type": ["object", "null"] }
      }
    },
    "calibrationRelease": { "type": "boolean" },
    "preflight": {
      "type": "object",
      "required": ["ok", "environment", "taskLock"],
      "properties": {
        "ok": { "type": "boolean" },
        "environment": {
          "type": "object",
          "required": ["ok", "missing"],
          "properties": {
            "ok": { "type": "boolean" },
            "missing": { "type": "array", "items": { "type": "string" } }
          }
        },
        "taskLock": {
          "type": "object",
          "required": ["ok", "reason"],
          "properties": {
            "ok": { "type": "boolean" },
            "reason": { "type": ["string", "null"] }
          }
        }
      }
    },
    "telemetryComplete": { "type": "boolean" },
    "deterministic": {
      "type": "object",
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": { "type": "number" },
        "failed": { "type": "number" },
        "skipped": { "type": "number" }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["complete", "requiredHosts", "expectedTasks", "observed", "missing", "duplicates", "unexpected", "reason"],
      "properties": {
        "complete": { "type": "boolean" },
        "requiredHosts": { "type": "array", "items": { "type": "string" } },
        "expectedTasks": { "type": "array", "items": { "type": "string" } },
        "observed": { "type": "array", "items": { "type": "object" } },
        "missing": { "type": "array", "items": { "type": "object" } },
        "duplicates": { "type": "array", "items": { "type": "object" } },
        "unexpected": { "type": "array", "items": { "type": "object" } },
        "reason": { "type": ["string", "null"] }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "result", "reason", "gateActive"],
        "properties": {
          "host": { "type": "string" },
          "comparisonTrack": { "const": "controlled-ablation" },
          "task": { "type": ["string", "null"] },
          "repetitionCount": { "type": ["number", "null"] },
          "result": {
            "enum": [
              "harness-win",
              "parity",
              "harness-regression",
              "inconclusive-capability",
              "infrastructure-invalid",
        "inconclusive-budget",
        "mixed-inconclusive",
        "flaky-inconclusive",
              "skipped"
            ]
          },
          "reason": { "type": "string" },
          "gateActive": { "type": "boolean" },
          "reproduced": { "type": ["boolean", "null"] },
          "rerun": {
            "type": ["object", "null"],
            "properties": {
              "task": { "type": ["string", "null"] },
              "pairId": { "type": ["string", "null"] },
              "repetitionCount": { "type": ["number", "null"] },
              "result": { "type": "string" },
              "reason": { "type": "string" },
              "safety": { "type": "boolean" },
              "causallyAttributable": { "type": "boolean" },
              "efficiencyDelta": { "type": ["object", "null"] },
              "generic": { "type": ["object", "null"] },
              "harness": { "type": ["object", "null"] }
            }
          },
          "efficiencyDelta": { "type": ["object", "null"] },
          "generic": { "type": ["object", "null"] },
          "harness": { "type": ["object", "null"] }
        }
      }
    },
    "nativeProducts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "comparisonTrack", "status"],
        "properties": {
          "host": { "type": "string" },
          "comparisonTrack": { "const": "native-product-reference" },
          "status": { "type": "string" },
          "telemetryAvailable": { "type": ["boolean", "null"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "smokes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "ok"],
        "properties": {
          "host": { "type": "string" },
          "ok": { "type": ["boolean", "null"] },
          "failed": { "type": ["array", "null"] }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["ceilingUsd", "spentUsd", "exhausted"],
      "properties": {
        "scope": { "const": "provider-api-only" },
        "ceilingUsd": { "type": "number" },
        "spentUsd": { "type": "number" },
        "exhausted": { "type": "boolean" },
        "breached": { "type": "boolean" },
        "overrunUsd": { "type": "number" },
        "reserveUsed": { "type": ["string", "null"] },
        "providerSpendGuard": {
          "type": "object",
          "required": ["verified", "limitUsd", "limitRemainingUsd", "reset", "checkedAt"],
          "properties": {
            "verified": { "type": "boolean" },
            "limitUsd": { "type": ["number", "null"] },
            "limitRemainingUsd": { "type": ["number", "null"] },
            "reset": { "type": ["string", "null"] },
            "checkedAt": { "type": ["string", "null"] }
          }
        },
        "billingUncertain": { "type": "boolean" },
        "enforcementSemantics": {
          "enum": [
            "provider-key-hard-limit-plus-conservative-scheduler",
            "scheduler-fail-stop-not-atomic-cash-guarantee"
          ]
        },
        "requestEstimateSemantics": {
          "const": "utf8-byte-prompt-token-upper-bound-plus-max-output-at-pinned-rates"
        },
        "allocations": {
          "type": "object",
          "required": ["controlledPairUsd", "regressionRerunUsd"],
          "properties": {
            "controlledPairUsd": { "type": "number" },
            "regressionRerunUsd": { "type": "number" }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["level", "statement", "controlledPairs", "controlledWins", "regressions", "treatmentFidelityModes"],
      "properties": {
        "level": { "enum": ["demonstrated-value", "bounded-overhead", "regression", "inconclusive"] },
        "statement": { "type": "string" },
        "controlledPairs": { "type": "number" },
        "controlledWins": { "type": "number" },
        "confirmedWins": { "type": "number" },
        "regressions": { "type": "number" },
        "treatmentFidelityModes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "readiness": {
      "type": "object",
      "required": ["policy", "ready", "reasons", "minimumHarnessSolvedTasks", "harnessSolvedTasks"],
      "properties": {
        "policy": { "type": "string" },
        "ready": { "type": ["boolean", "null"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "minimumHarnessSolvedTasks": { "type": ["number", "null"] },
        "harnessSolvedTasks": { "type": ["number", "null"] }
      }
    },
    "gate": {
      "type": "object",
      "required": ["block", "reasons"],
      "properties": {
        "block": { "type": "boolean" },
        "reasons": { "type": "array" }
      }
    },
    "limitations": { "type": ["array", "null"] }
  }
}
