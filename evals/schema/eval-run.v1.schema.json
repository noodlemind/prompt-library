{
  "$id": "eval-run.v1",
  "title": "One eval trial (one condition of one A/B pair)",
  "type": "object",
  "$defs": {
    "economicPhase": {
      "type": "object",
      "required": [
        "status", "logicalRequests", "usageRecords", "promptTokens", "cachedPromptTokens",
        "reasoningTokens", "outputTokens", "localCostUsd", "providerReportedCostUsd",
        "reconciledCostUsd", "promptTokensComplete", "cachedPromptTokensComplete",
        "reasoningTokensComplete", "outputTokensComplete", "localCostUsdComplete",
        "providerReportedCostUsdComplete", "reconciledCostUsdComplete"
      ],
      "properties": {
        "status": { "enum": ["measured", "not_exercised", "partial", "unavailable", "aggregate"] },
        "logicalRequests": { "type": "integer", "minimum": 0 },
        "usageRecords": { "type": "integer", "minimum": 0 },
        "promptTokens": { "type": ["number", "null"], "minimum": 0 },
        "cachedPromptTokens": { "type": ["number", "null"], "minimum": 0 },
        "reasoningTokens": { "type": ["number", "null"], "minimum": 0 },
        "outputTokens": { "type": ["number", "null"], "minimum": 0 },
        "localCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "providerReportedCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "reconciledCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "promptTokensComplete": { "type": "boolean" },
        "cachedPromptTokensComplete": { "type": "boolean" },
        "reasoningTokensComplete": { "type": "boolean" },
        "outputTokensComplete": { "type": "boolean" },
        "localCostUsdComplete": { "type": "boolean" },
        "providerReportedCostUsdComplete": { "type": "boolean" },
        "reconciledCostUsdComplete": { "type": "boolean" },
        "repetitionsObserved": { "type": "integer", "minimum": 0 },
        "repetitionCoverage": { "type": ["number", "null"], "minimum": 0 }
        ,"derivedFrom": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "economicTotals": {
      "type": ["object", "null"],
      "required": [
        "logicalRequests", "usageRecords", "promptTokens", "cachedPromptTokens", "reasoningTokens",
        "outputTokens", "localCostUsd", "providerReportedCostUsd", "reconciledCostUsd",
        "promptTokensComplete", "cachedPromptTokensComplete", "reasoningTokensComplete",
        "outputTokensComplete", "localCostUsdComplete", "providerReportedCostUsdComplete",
        "reconciledCostUsdComplete"
      ],
      "properties": {
        "logicalRequests": { "type": "integer", "minimum": 0 },
        "usageRecords": { "type": "integer", "minimum": 0 },
        "promptTokens": { "type": ["number", "null"], "minimum": 0 },
        "cachedPromptTokens": { "type": ["number", "null"], "minimum": 0 },
        "reasoningTokens": { "type": ["number", "null"], "minimum": 0 },
        "outputTokens": { "type": ["number", "null"], "minimum": 0 },
        "localCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "providerReportedCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "reconciledCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "promptTokensComplete": { "type": "boolean" },
        "cachedPromptTokensComplete": { "type": "boolean" },
        "reasoningTokensComplete": { "type": "boolean" },
        "outputTokensComplete": { "type": "boolean" },
        "localCostUsdComplete": { "type": "boolean" },
        "providerReportedCostUsdComplete": { "type": "boolean" },
        "reconciledCostUsdComplete": { "type": "boolean" }
      }
    },
    "promptComponent": {
      "type": "object",
      "required": ["id", "ordinal", "startChar", "endChar", "chars", "bytes", "sha256"],
      "properties": {
        "id": { "type": "string" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "startChar": { "type": "integer", "minimum": 0 },
        "endChar": { "type": "integer", "minimum": 0 },
        "chars": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" }
      }
    },
    "promptManifest": {
      "type": ["object", "null"],
      "required": ["schema", "separator", "systemPromptChars", "systemPromptBytes", "systemPromptHash", "complete", "components"],
      "properties": {
        "schema": { "const": "prompt-component-manifest.v1" },
        "separator": { "const": "\n\n" },
        "systemPromptChars": { "type": "integer", "minimum": 0 },
        "systemPromptBytes": { "type": "integer", "minimum": 0 },
        "systemPromptHash": { "type": "string" },
        "complete": { "type": "boolean" },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/promptComponent" } }
      }
    }
  },
  "required": ["schema", "reproducibility", "correctness", "efficiency", "harnessBehavior", "subscription"],
  "properties": {
    "schema": { "const": "eval-run.v1" },
    "reproducibility": {
      "type": "object",
      "required": [
        "releaseSha",
        "harnessVersion",
        "harnessContentHash",
        "taskId",
        "taskRevision",
        "condition",
        "modelRequested",
        "modelResolved",
        "providerResolved",
        "host",
        "reasoningConfig",
        "runnerVersion",
        "sandbox",
        "startedAt",
        "endedAt"
      ],
      "properties": {
        "releaseSha": { "type": "string" },
        "harnessVersion": { "type": "string" },
        "harnessContentHash": { "type": ["string", "null"] },
        "taskId": { "type": "string" },
        "taskRevision": { "type": ["string", "null"] },
        "condition": { "enum": ["generic", "harness"] },
        "modelProfileId": { "type": "string" },
        "billingProfileHash": { "type": "string" },
        "pricingCatalogCheckedAt": { "type": ["string", "null"] },
        "modelRequested": { "type": "string" },
        "modelResolved": { "type": ["string", "null"] },
        "providerResolved": { "type": ["string", "null"] },
        "host": { "type": "string" },
        "reasoningConfig": { "type": ["object", "null"] },
        "runnerVersion": { "type": "string" },
        "sandbox": { "type": ["object", "null"] },
        "startedAt": { "type": "string" },
        "endedAt": { "type": ["string", "null"] },
        "pairId": { "type": ["string", "null"] },
        "repetitionId": { "type": ["string", "null"] },
        "repetitionIndex": { "type": ["number", "null"], "minimum": 1 },
        "orderIndex": { "type": ["number", "null"], "minimum": 1 },
        "attempt": { "type": ["string", "null"] },
        "aggregation": { "type": ["string", "null"] },
        "trialCeilingUsd": { "type": ["number", "null"], "minimum": 0 },
        "taskHash": { "type": ["string", "null"] },
        "bundleManifestHash": { "type": ["string", "null"] },
        "conditionHash": { "type": ["string", "null"] },
        "systemPromptHash": { "type": ["string", "null"] },
        "instructionHash": { "type": ["string", "null"] },
        "toolSchemaHash": { "type": ["string", "null"] },
        "telemetryHash": { "type": ["string", "null"] },
        "harnessEventsHash": { "type": ["string", "null"] }
      }
    },
    "correctness": {
      "type": "object",
      "required": ["verifierReward", "verdict", "exitReason", "completedWithinTimeout", "completedWithinBudget"],
      "properties": {
        "verifierReward": { "type": ["number", "null"] },
        "verdict": { "enum": ["pass", "fail"] },
        "assertionsPassed": { "type": ["number", "null"] },
        "assertionsFailed": { "type": ["number", "null"] },
        "requiredFilesCreated": { "type": ["boolean", "null"] },
        "finalDiffHash": { "type": ["string", "null"] },
        "verifierArtifactHash": { "type": ["string", "null"] },
        "exitReason": { "type": "string" },
        "completedWithinTimeout": { "type": "boolean" },
        "completedWithinBudget": { "type": "boolean" }
      }
    },
    "trialValidity": {
      "type": "object",
      "required": ["valid", "failureKind"],
      "properties": {
        "valid": { "type": "boolean" },
        "failureKind": { "type": ["string", "null"] }
      }
    },
    "efficiency": {
      "type": "object",
      "required": [
        "wallTimeMs",
        "modelRequests",
        "toolCalls",
        "terminalCommands",
        "failedCommands",
        "promptTokens",
        "cachedPromptTokens",
        "reasoningTokens",
        "outputTokens",
        "providerReportedCostUsd",
        "localCostUsd"
      ],
      "properties": {
        "wallTimeMs": { "type": ["number", "null"] },
        "timeToFirstTerminalActionMs": { "type": ["number", "null"] },
        "timeToFirstEditMs": { "type": ["number", "null"] },
        "timeFromFinalEditToVerificationMs": { "type": ["number", "null"] },
        "modelRequests": { "type": ["number", "null"] },
        "providerAttempts": { "type": ["number", "null"] },
        "providerResponses": { "type": ["number", "null"] },
        "providerErrors": { "type": ["number", "null"] },
        "openProviderAttempts": { "type": ["number", "null"] },
        "unknownBillingAttempts": { "type": ["number", "null"] },
        "toolCalls": { "type": ["number", "null"] },
        "terminalCommands": { "type": ["number", "null"] },
        "failedCommands": { "type": ["number", "null"] },
        "testExecutions": { "type": ["number", "null"] },
        "failedTests": { "type": ["number", "null"] },
        "retries": { "type": ["number", "null"] },
        "contextCompactions": { "type": ["number", "null"] },
        "compactedToolResults": { "type": ["number", "null"] },
        "requestPayloadChars": { "type": ["number", "null"] },
        "peakRequestPayloadChars": { "type": ["number", "null"] },
        "promptTokens": { "type": ["number", "null"] },
        "cachedPromptTokens": { "type": ["number", "null"] },
        "reasoningTokens": { "type": ["number", "null"] },
        "cachedPromptTokensComplete": { "type": ["boolean", "null"] },
        "reasoningTokensComplete": { "type": ["boolean", "null"] },
        "outputTokens": { "type": ["number", "null"] },
        "providerReportedCostUsd": { "type": ["number", "null"] },
        "localCostUsd": { "type": ["number", "null"] },
        "reconciledCostUsd": { "type": ["number", "null"] },
        "usageComplete": { "type": ["boolean", "null"] },
        "providerCostComplete": { "type": ["boolean", "null"] },
        "billingComplete": { "type": ["boolean", "null"] },
        "costComplete": { "type": ["boolean", "null"] },
        "missingUsage": { "type": ["number", "null"] }
      }
    },
    "economics": {
      "type": ["object", "null"],
      "required": ["coverage", "prompt", "phases", "rollups", "totals", "reconciliation"],
      "properties": {
        "coverage": {
          "type": "object",
          "required": ["status", "complete", "requestEvents", "usageEvents", "matchedUsageEvents", "reason"],
          "properties": {
            "status": { "enum": ["complete", "partial", "unavailable"] },
            "complete": { "type": "boolean" },
            "requestEvents": { "type": "integer", "minimum": 0 },
            "usageEvents": { "type": "integer", "minimum": 0 },
            "matchedUsageEvents": { "type": "integer", "minimum": 0 },
            "reason": { "type": ["string", "null"] }
          }
        },
        "prompt": {
          "type": "object",
          "required": ["manifest", "coverage", "cumulative"],
          "properties": {
            "manifest": { "$ref": "#/$defs/promptManifest" },
            "coverage": {
              "type": "object",
              "required": ["complete", "requests", "requestsWithCompleteBuckets"],
              "properties": {
                "complete": { "type": "boolean" },
                "requests": { "type": "integer", "minimum": 0 },
                "requestsWithCompleteBuckets": { "type": "integer", "minimum": 0 }
              }
            },
            "cumulative": {
              "type": ["object", "null"],
              "required": [
                "payloadChars", "baseSystemChars", "instructionChars", "durableStateChars",
                "assistantHistoryChars", "toolResultHistoryChars", "otherMessageChars",
                "messageEnvelopeChars", "toolSchemaChars", "payloadEnvelopeChars",
                "toolResultHistoryBySource"
              ],
              "properties": {
                "payloadChars": { "type": ["integer", "null"], "minimum": 0 },
                "baseSystemChars": { "type": ["integer", "null"], "minimum": 0 },
                "instructionChars": { "type": ["integer", "null"], "minimum": 0 },
                "durableStateChars": { "type": ["integer", "null"], "minimum": 0 },
                "assistantHistoryChars": { "type": ["integer", "null"], "minimum": 0 },
                "toolResultHistoryChars": { "type": ["integer", "null"], "minimum": 0 },
                "otherMessageChars": { "type": ["integer", "null"], "minimum": 0 },
                "messageEnvelopeChars": { "type": ["integer", "null"], "minimum": 0 },
                "toolSchemaChars": { "type": ["integer", "null"], "minimum": 0 },
                "payloadEnvelopeChars": { "type": ["integer", "null"], "minimum": 0 },
                "toolResultHistoryBySource": {
                  "type": ["object", "null"],
                  "additionalProperties": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "phases": {
          "type": "object",
          "required": [
            "memory-retrieval", "memory-construction", "memory-consolidation", "guidance",
            "planning-and-gate", "verification", "orientation", "implementation",
            "finalization", "uncategorized", "mixed", "unknown"
          ],
          "properties": {
            "memory-retrieval": { "$ref": "#/$defs/economicPhase" },
            "memory-construction": { "$ref": "#/$defs/economicPhase" },
            "memory-consolidation": { "$ref": "#/$defs/economicPhase" },
            "guidance": { "$ref": "#/$defs/economicPhase" },
            "planning-and-gate": { "$ref": "#/$defs/economicPhase" },
            "verification": { "$ref": "#/$defs/economicPhase" },
            "orientation": { "$ref": "#/$defs/economicPhase" },
            "implementation": { "$ref": "#/$defs/economicPhase" },
            "finalization": { "$ref": "#/$defs/economicPhase" },
            "uncategorized": { "$ref": "#/$defs/economicPhase" },
            "mixed": { "$ref": "#/$defs/economicPhase" },
            "unknown": { "$ref": "#/$defs/economicPhase" }
          }
        },
        "rollups": {
          "type": "object",
          "required": ["task-execution"],
          "properties": {
            "task-execution": { "$ref": "#/$defs/economicPhase" }
          }
        },
        "totals": { "$ref": "#/$defs/economicTotals" },
        "reconciliation": {
          "type": "object",
          "required": ["complete", "checks", "reason"],
          "properties": {
            "complete": { "type": "boolean" },
            "checks": { "type": ["object", "null"] },
            "reason": { "type": ["string", "null"] }
          }
        }
      }
    },
    "harnessBehavior": {
      "type": "object",
      "required": [
        "orientInvoked",
        "planCreatedOrSelected",
        "gateAttempts",
        "gateDenials",
        "outOfScopeMutationAttempts",
        "dangerousCommandAttempts",
        "verificationAfterFinalMutation",
        "prematureFinishAttempts",
        "completionBlockedForVerification",
        "reviewPerformed",
        "policyBypassAttempted",
        "policyBypassAchieved"
      ],
      "properties": {
        "orientInvoked": { "type": ["boolean", "null"] },
        "planCreatedOrSelected": { "type": ["boolean", "null"] },
        "gateAttempts": { "type": ["number", "null"] },
        "gateDenials": { "type": ["number", "null"] },
        "outOfScopeMutationAttempts": { "type": ["number", "null"] },
        "dangerousCommandAttempts": { "type": ["number", "null"] },
        "verificationAfterFinalMutation": { "type": ["boolean", "null"] },
        "prematureFinishAttempts": { "type": ["number", "null"] },
        "completionBlockedForVerification": { "type": ["boolean", "null"] },
        "reviewPerformed": { "type": ["boolean", "null"] },
        "policyBypassAttempted": { "type": ["boolean", "null"] },
        "policyBypassAchieved": { "type": ["boolean", "null"] }
      }
    },
    "enforcementFidelity": {
      "type": "object",
      "required": ["mode", "promptContractActive", "cliActivated", "mechanicalHooksActive", "harnessEventsCaptured", "evidenceSource"],
      "properties": {
        "mode": { "enum": ["none", "prompt-and-cli", "mechanical-hooks"] },
        "promptContractActive": { "type": "boolean" },
        "cliActivated": { "type": "boolean" },
        "cliInvoked": { "type": "boolean" },
        "cliSucceeded": { "type": "boolean" },
        "mechanicalHooksActive": { "type": "boolean" },
        "harnessEventsCaptured": { "type": "boolean" },
        "evidenceSource": { "type": "string" }
      }
    },
    "workspaceEvidence": {
      "type": "object",
      "required": ["available", "collectionMode", "beforeManifestHash", "afterManifestHash", "diffHash", "changedPaths", "changedPathCount", "changedPathsTruncated", "reason"],
      "properties": {
        "available": { "type": "boolean" },
        "collectionMode": { "type": ["string", "null"] },
        "containmentMode": {
          "type": ["string", "null"],
          "enum": ["descriptor-relative-procfs", "identity-checked-path-fallback", null]
        },
        "beforeManifestHash": { "type": ["string", "null"] },
        "afterManifestHash": { "type": ["string", "null"] },
        "diffHash": { "type": ["string", "null"] },
        "changedPaths": { "type": "array", "items": { "type": "string" } },
        "changedPathCount": { "type": "number" },
        "changedPathsTruncated": { "type": "boolean" },
        "gitStateAvailable": { "type": ["boolean", "null"] },
        "gitStatePresent": { "type": ["boolean", "null"] },
        "beforeGitStateHash": { "type": ["string", "null"] },
        "afterGitStateHash": { "type": ["string", "null"] },
        "gitStateChanged": { "type": ["boolean", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "observability": {
      "type": "object",
      "required": ["providerEvents", "toolEvents", "harnessEvents", "harnessEventEvidence", "providerAttemptsStarted", "providerAttemptsClosed", "unclosedProviderAttempts", "correlatedToolResults", "uncorrelatedToolResults", "eventEvidenceHash"],
      "properties": {
        "providerEvents": { "type": "array", "items": { "type": "object" } },
        "toolEvents": { "type": "array", "items": { "type": "object" } },
        "harnessEvents": { "type": "array", "items": { "type": "object" } },
        "harnessEventEvidence": {
          "type": "object",
          "required": ["available", "reason", "retainedEvents", "sourceTruncated"],
          "properties": {
            "available": { "type": "boolean" },
            "complete": { "type": "boolean" },
            "reason": { "type": ["string", "null"] },
            "retainedEvents": { "type": "number" },
            "sourceTruncated": { "type": "boolean" },
            "projectionRejectedEvents": { "type": "number", "minimum": 0 },
            "projectionRejectedChecks": { "type": "number", "minimum": 0 }
          }
        },
        "providerAttemptsStarted": { "type": "number" },
        "providerAttemptsClosed": { "type": "number" },
        "unclosedProviderAttempts": { "type": "number" },
        "uncorrelatedProviderTerminals": { "type": "number", "minimum": 0 },
        "duplicateProviderAttemptIdentities": { "type": "number", "minimum": 0 },
        "duplicateProviderTerminalIdentities": { "type": "number", "minimum": 0 },
        "invalidProviderEventIdentities": { "type": "number", "minimum": 0 },
        "correlatedToolResults": { "type": "number" },
        "uncorrelatedToolResults": { "type": "number" },
        "unclosedToolCalls": { "type": "number", "minimum": 0 },
        "duplicateToolCallIdentities": { "type": "number", "minimum": 0 },
        "duplicateToolResultIdentities": { "type": "number", "minimum": 0 },
        "invalidToolEventIdentities": { "type": "number", "minimum": 0 },
        "malformedToolCallEvidence": { "type": "number", "minimum": 0 },
        "malformedToolResultEvidence": { "type": "number", "minimum": 0 },
        "invalidToolArguments": { "type": "number", "minimum": 0 },
        "incompleteToolContainment": { "type": "number", "minimum": 0 },
        "controlContaminationDetected": { "type": "boolean" },
        "runtimeTrustEvidence": {
          "type": ["object", "null"],
          "required": ["schema", "evidenceHash", "providerSpendMicrousd"],
          "additionalProperties": false,
          "properties": {
            "schema": { "const": "engineer-runtime-trial-final-attestation.v1" },
            "evidenceHash": { "type": "string" },
            "providerSpendMicrousd": { "type": "integer", "minimum": 0, "maximum": 20000000 }
          }
        },
        "runtimeContractEvidence": {
          "type": "object",
          "required": ["complete", "matchesExpected", "expectedSystemPromptHash", "actualSystemPromptHash", "expectedToolSchemaHash", "actualToolSchemaHash", "expectedToolCount", "actualToolCount", "instructionHash", "reason"],
          "properties": {
            "complete": { "type": "boolean" },
            "matchesExpected": { "type": "boolean" },
            "expectedSystemPromptHash": { "type": ["string", "null"] },
            "actualSystemPromptHash": { "type": ["string", "null"] },
            "expectedToolSchemaHash": { "type": ["string", "null"] },
            "actualToolSchemaHash": { "type": ["string", "null"] },
            "expectedToolCount": { "type": ["number", "null"] },
            "actualToolCount": { "type": ["number", "null"] },
            "expectedFinishToolSchemaHash": { "type": ["string", "null"] },
            "expectedFinishToolCount": { "type": ["number", "null"] },
            "expectedPromptComponentManifestHash": { "type": ["string", "null"] },
            "actualPromptComponentManifestHash": { "type": ["string", "null"] },
            "requestContractsChecked": { "type": "number", "minimum": 0 },
            "postVerifyRequestContracts": { "type": "number", "minimum": 0 },
            "requestPromptMismatches": { "type": "number", "minimum": 0 },
            "requestPromptManifestMismatches": { "type": "number", "minimum": 0 },
            "requestPromptBucketMismatches": { "type": "number", "minimum": 0 },
            "requestControlMismatches": { "type": "number", "minimum": 0 },
            "requestContractMismatches": { "type": "number", "minimum": 0 },
            "expectedRequestControlHash": { "type": ["string", "null"] },
            "expectedInstructionHash": { "type": ["string", "null"] },
            "actualInstructionHash": { "type": ["string", "null"] },
            "instructionHash": { "type": ["string", "null"] },
            "reason": { "type": ["string", "null"] }
          }
        },
        "mountPolicyEvidence": {
          "type": "object",
          "required": ["version", "complete", "matchesCondition", "structurallyIsolated", "effectiveTargets", "commonTargets", "treatmentOnlyTargets", "reason"],
          "properties": {
            "version": { "type": ["string", "null"] },
            "source": { "type": ["string", "null"] },
            "observed": { "type": "boolean" },
            "complete": { "type": "boolean" },
            "matchesCondition": { "type": "boolean" },
            "structurallyIsolated": { "type": "boolean" },
            "effectiveTargets": { "type": "array", "items": { "type": "string" } },
            "commonTargets": { "type": "array", "items": { "type": "string" } },
            "treatmentOnlyTargets": { "type": "array", "items": { "type": "string" } },
            "reason": { "type": ["string", "null"] }
          }
        },
        "eventEvidenceHash": { "type": "string" }
      }
    },
    "repetitions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "correctionEffort": {
      "type": ["object", "null"],
      "properties": {
        "humanInterventions": { "type": ["number", "null"] },
        "correctionTurns": { "type": ["number", "null"] },
        "interventionTokens": { "type": ["number", "null"] }
      }
    },
    "subscription": {
      "type": ["object", "null"],
      "properties": {
        "premiumRequestsConsumed": { "type": ["number", "null"] },
        "rateLimitEvents": { "type": ["number", "null"] },
        "hostReportedPromptTokens": { "type": ["number", "null"] },
        "hostReportedOutputTokens": { "type": ["number", "null"] },
        "hostReportedModel": { "type": ["string", "null"] },
        "fallbackObserved": { "type": ["boolean", "null"] }
      }
    }
  }
}
