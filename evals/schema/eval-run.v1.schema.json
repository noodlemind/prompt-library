{
  "$id": "eval-run.v1",
  "title": "One eval trial (one condition of one A/B pair)",
  "type": "object",
  "required": ["schema", "reproducibility", "correctness", "efficiency", "harnessBehavior", "subscription"],
  "properties": {
    "schema": { "const": "eval-run.v1" },
    "reproducibility": {
      "type": "object",
      "required": [
        "releaseSha",
        "harnessVersion",
        "harnessContentHash",
        "taskId",
        "taskRevision",
        "condition",
        "modelRequested",
        "modelResolved",
        "providerResolved",
        "host",
        "reasoningConfig",
        "runnerVersion",
        "sandbox",
        "startedAt",
        "endedAt"
      ],
      "properties": {
        "releaseSha": { "type": "string" },
        "harnessVersion": { "type": "string" },
        "harnessContentHash": { "type": ["string", "null"] },
        "taskId": { "type": "string" },
        "taskRevision": { "type": ["string", "null"] },
        "condition": { "enum": ["generic", "harness"] },
        "modelRequested": { "type": "string" },
        "modelResolved": { "type": ["string", "null"] },
        "providerResolved": { "type": ["string", "null"] },
        "host": { "type": "string" },
        "reasoningConfig": { "type": ["object", "null"] },
        "runnerVersion": { "type": "string" },
        "sandbox": { "type": ["object", "null"] },
        "startedAt": { "type": "string" },
        "endedAt": { "type": ["string", "null"] },
        "pairId": { "type": ["string", "null"] },
        "repetitionId": { "type": ["string", "null"] },
        "repetitionIndex": { "type": ["number", "null"], "minimum": 1 },
        "orderIndex": { "type": ["number", "null"], "minimum": 1 },
        "attempt": { "type": ["string", "null"] },
        "aggregation": { "type": ["string", "null"] },
        "taskHash": { "type": ["string", "null"] },
        "bundleManifestHash": { "type": ["string", "null"] },
        "conditionHash": { "type": ["string", "null"] },
        "systemPromptHash": { "type": ["string", "null"] },
        "instructionHash": { "type": ["string", "null"] },
        "toolSchemaHash": { "type": ["string", "null"] },
        "telemetryHash": { "type": ["string", "null"] },
        "harnessEventsHash": { "type": ["string", "null"] }
      }
    },
    "correctness": {
      "type": "object",
      "required": ["verifierReward", "verdict", "exitReason", "completedWithinTimeout", "completedWithinBudget"],
      "properties": {
        "verifierReward": { "type": ["number", "null"] },
        "verdict": { "enum": ["pass", "fail"] },
        "assertionsPassed": { "type": ["number", "null"] },
        "assertionsFailed": { "type": ["number", "null"] },
        "requiredFilesCreated": { "type": ["boolean", "null"] },
        "finalDiffHash": { "type": ["string", "null"] },
        "verifierArtifactHash": { "type": ["string", "null"] },
        "exitReason": { "type": "string" },
        "completedWithinTimeout": { "type": "boolean" },
        "completedWithinBudget": { "type": "boolean" }
      }
    },
    "efficiency": {
      "type": "object",
      "required": [
        "wallTimeMs",
        "modelRequests",
        "toolCalls",
        "terminalCommands",
        "failedCommands",
        "promptTokens",
        "cachedPromptTokens",
        "reasoningTokens",
        "outputTokens",
        "providerReportedCostUsd",
        "localCostUsd"
      ],
      "properties": {
        "wallTimeMs": { "type": ["number", "null"] },
        "timeToFirstTerminalActionMs": { "type": ["number", "null"] },
        "timeToFirstEditMs": { "type": ["number", "null"] },
        "timeFromFinalEditToVerificationMs": { "type": ["number", "null"] },
        "modelRequests": { "type": ["number", "null"] },
        "providerAttempts": { "type": ["number", "null"] },
        "providerResponses": { "type": ["number", "null"] },
        "providerErrors": { "type": ["number", "null"] },
        "openProviderAttempts": { "type": ["number", "null"] },
        "unknownBillingAttempts": { "type": ["number", "null"] },
        "toolCalls": { "type": ["number", "null"] },
        "terminalCommands": { "type": ["number", "null"] },
        "failedCommands": { "type": ["number", "null"] },
        "testExecutions": { "type": ["number", "null"] },
        "failedTests": { "type": ["number", "null"] },
        "retries": { "type": ["number", "null"] },
        "contextCompactions": { "type": ["number", "null"] },
        "compactedToolResults": { "type": ["number", "null"] },
        "requestPayloadChars": { "type": ["number", "null"] },
        "peakRequestPayloadChars": { "type": ["number", "null"] },
        "promptTokens": { "type": ["number", "null"] },
        "cachedPromptTokens": { "type": ["number", "null"] },
        "reasoningTokens": { "type": ["number", "null"] },
        "outputTokens": { "type": ["number", "null"] },
        "providerReportedCostUsd": { "type": ["number", "null"] },
        "localCostUsd": { "type": ["number", "null"] },
        "reconciledCostUsd": { "type": ["number", "null"] },
        "usageComplete": { "type": ["boolean", "null"] },
        "providerCostComplete": { "type": ["boolean", "null"] },
        "billingComplete": { "type": ["boolean", "null"] },
        "costComplete": { "type": ["boolean", "null"] },
        "missingUsage": { "type": ["number", "null"] }
      }
    },
    "harnessBehavior": {
      "type": "object",
      "required": [
        "orientInvoked",
        "planCreatedOrSelected",
        "gateAttempts",
        "gateDenials",
        "outOfScopeMutationAttempts",
        "dangerousCommandAttempts",
        "verificationAfterFinalMutation",
        "prematureFinishAttempts",
        "completionBlockedForVerification",
        "reviewPerformed",
        "policyBypassAttempted",
        "policyBypassAchieved"
      ],
      "properties": {
        "orientInvoked": { "type": ["boolean", "null"] },
        "planCreatedOrSelected": { "type": ["boolean", "null"] },
        "gateAttempts": { "type": ["number", "null"] },
        "gateDenials": { "type": ["number", "null"] },
        "outOfScopeMutationAttempts": { "type": ["number", "null"] },
        "dangerousCommandAttempts": { "type": ["number", "null"] },
        "verificationAfterFinalMutation": { "type": ["boolean", "null"] },
        "prematureFinishAttempts": { "type": ["number", "null"] },
        "completionBlockedForVerification": { "type": ["boolean", "null"] },
        "reviewPerformed": { "type": ["boolean", "null"] },
        "policyBypassAttempted": { "type": ["boolean", "null"] },
        "policyBypassAchieved": { "type": ["boolean", "null"] }
      }
    },
    "enforcementFidelity": {
      "type": "object",
      "required": ["mode", "promptContractActive", "cliActivated", "mechanicalHooksActive", "harnessEventsCaptured", "evidenceSource"],
      "properties": {
        "mode": { "enum": ["none", "prompt-and-cli", "mechanical-hooks"] },
        "promptContractActive": { "type": "boolean" },
        "cliActivated": { "type": "boolean" },
        "mechanicalHooksActive": { "type": "boolean" },
        "harnessEventsCaptured": { "type": "boolean" },
        "evidenceSource": { "type": "string" }
      }
    },
    "workspaceEvidence": {
      "type": "object",
      "required": ["available", "collectionMode", "beforeManifestHash", "afterManifestHash", "diffHash", "changedPaths", "changedPathCount", "changedPathsTruncated", "reason"],
      "properties": {
        "available": { "type": "boolean" },
        "collectionMode": { "type": ["string", "null"] },
        "containmentMode": {
          "type": ["string", "null"],
          "enum": ["descriptor-relative-procfs", "identity-checked-path-fallback", null]
        },
        "beforeManifestHash": { "type": ["string", "null"] },
        "afterManifestHash": { "type": ["string", "null"] },
        "diffHash": { "type": ["string", "null"] },
        "changedPaths": { "type": "array", "items": { "type": "string" } },
        "changedPathCount": { "type": "number" },
        "changedPathsTruncated": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "observability": {
      "type": "object",
      "required": ["providerEvents", "toolEvents", "harnessEvents", "harnessEventEvidence", "providerAttemptsStarted", "providerAttemptsClosed", "unclosedProviderAttempts", "correlatedToolResults", "uncorrelatedToolResults", "eventEvidenceHash"],
      "properties": {
        "providerEvents": { "type": "array", "items": { "type": "object" } },
        "toolEvents": { "type": "array", "items": { "type": "object" } },
        "harnessEvents": { "type": "array", "items": { "type": "object" } },
        "harnessEventEvidence": {
          "type": "object",
          "required": ["available", "reason", "retainedEvents", "sourceTruncated"],
          "properties": {
            "available": { "type": "boolean" },
            "complete": { "type": "boolean" },
            "reason": { "type": ["string", "null"] },
            "retainedEvents": { "type": "number" },
            "sourceTruncated": { "type": "boolean" },
            "projectionRejectedEvents": { "type": "number", "minimum": 0 },
            "projectionRejectedChecks": { "type": "number", "minimum": 0 }
          }
        },
        "providerAttemptsStarted": { "type": "number" },
        "providerAttemptsClosed": { "type": "number" },
        "unclosedProviderAttempts": { "type": "number" },
        "uncorrelatedProviderTerminals": { "type": "number", "minimum": 0 },
        "duplicateProviderAttemptIdentities": { "type": "number", "minimum": 0 },
        "duplicateProviderTerminalIdentities": { "type": "number", "minimum": 0 },
        "invalidProviderEventIdentities": { "type": "number", "minimum": 0 },
        "correlatedToolResults": { "type": "number" },
        "uncorrelatedToolResults": { "type": "number" },
        "unclosedToolCalls": { "type": "number", "minimum": 0 },
        "duplicateToolCallIdentities": { "type": "number", "minimum": 0 },
        "duplicateToolResultIdentities": { "type": "number", "minimum": 0 },
        "invalidToolEventIdentities": { "type": "number", "minimum": 0 },
        "runtimeContractEvidence": {
          "type": "object",
          "required": ["complete", "matchesExpected", "expectedSystemPromptHash", "actualSystemPromptHash", "expectedToolSchemaHash", "actualToolSchemaHash", "expectedToolCount", "actualToolCount", "instructionHash", "reason"],
          "properties": {
            "complete": { "type": "boolean" },
            "matchesExpected": { "type": "boolean" },
            "expectedSystemPromptHash": { "type": ["string", "null"] },
            "actualSystemPromptHash": { "type": ["string", "null"] },
            "expectedToolSchemaHash": { "type": ["string", "null"] },
            "actualToolSchemaHash": { "type": ["string", "null"] },
            "expectedToolCount": { "type": ["number", "null"] },
            "actualToolCount": { "type": ["number", "null"] },
            "instructionHash": { "type": ["string", "null"] },
            "reason": { "type": ["string", "null"] }
          }
        },
        "eventEvidenceHash": { "type": "string" }
      }
    },
    "repetitions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "subscription": {
      "type": ["object", "null"],
      "properties": {
        "premiumRequestsConsumed": { "type": ["number", "null"] },
        "rateLimitEvents": { "type": ["number", "null"] },
        "hostReportedPromptTokens": { "type": ["number", "null"] },
        "hostReportedOutputTokens": { "type": ["number", "null"] },
        "hostReportedModel": { "type": ["string", "null"] },
        "fallbackObserved": { "type": ["boolean", "null"] }
      }
    }
  }
}
