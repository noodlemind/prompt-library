{
  "version": 1,
  "description": "Copilot CLI lifecycle hooks — synced to ~/.copilot/hooks/ on harness install. Commands run with cwd = hooks directory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node load-context.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|edit|editFiles|apply_patch|create_file|replace_string_in_file",
        "hooks": [
          {
            "type": "command",
            "command": "node require-plan-gate.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node guard-critical-files.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node require-plan-gate.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node block-destructive-commands.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node preserve-context.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node require-verification.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
