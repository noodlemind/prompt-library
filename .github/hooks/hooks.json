{
  "version": 1,
  "description": "GitHub Copilot lifecycle hooks for VS Code and CLI; install rewrites command cwd to the hydrated user hook directory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node load-context.mjs",
            "cwd": ".github/hooks",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|edit|editFiles|multi_replace_string_in_file|replace_string_in_file|apply_patch|create_file|createFile",
        "hooks": [
          {
            "type": "command",
            "command": "node guard-critical-files.mjs",
            "cwd": ".github/hooks",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node require-plan-gate.mjs",
            "cwd": ".github/hooks",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_in_terminal|runTerminalCommand|execute|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node guard-critical-files.mjs",
            "cwd": ".github/hooks",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node block-destructive-commands.mjs",
            "cwd": ".github/hooks",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node require-plan-gate.mjs",
            "cwd": ".github/hooks",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node record-successful-edit.mjs",
            "cwd": ".github/hooks",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node preserve-context.mjs",
            "cwd": ".github/hooks",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node require-verification.mjs",
            "cwd": ".github/hooks",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
