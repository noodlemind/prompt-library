{
  "name": "ae-harness",
  "version": "0.13.0",
  "description": "Adaptive Engineering CLI for GitHub Copilot",
  "homepage": "https://github.com/noodlemind/prompt-library",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ae": "./bin/ae.mjs"
  },
  "files": [
    "bin",
    "lib",
    "config",
    "corpus",
    "vscode-extension",
    "retired.json",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "scripts/check-release.mjs"
  ],
  "//bundledDependencies": "All hard runtime dependencies ship inside the tarball for offline installation and diagram rendering. Pele and D2/WASM are pinned, package-owned libraries; diagramming requires no separate executable, server or download. Optional tree-sitter grammars retain lexical fallback. Bundled dependency fixes require an AE republish; review advisories and upstream licenses on every release.",
  "scripts": {
    "check:release": "node ./scripts/check-release.mjs",
    "check:repo": "node --test ./test/release-version.test.mjs ./test/prompt-library-contracts.test.mjs",
    "preversion": "npm run check:release",
    "version": "npm run check:release",
    "prepack": "npm run check:release",
    "doctor": "node ./bin/ae.mjs doctor",
    "install:local": "node ./bin/ae.mjs install --configure-vscode --configure-path",
    "install:global": "npm install -g .",
    "test": "node ./test/run.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlemind/prompt-library.git",
    "directory": "packages/ae"
  },
  "dependencies": {
    "@d2lang/d2": "0.1.34",
    "pele": "1.8.0",
    "yaml": "^2.9.0"
  },
  "bundledDependencies": [
    "@d2lang/d2",
    "pele",
    "yaml"
  ],
  "keywords": [
    "github-copilot",
    "agent-skills",
    "adaptive-engineer",
    "harness"
  ],
  "optionalDependencies": {
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.23.6",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.25.10"
  }
}
