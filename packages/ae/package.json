{
  "name": "ae-harness",
  "version": "0.14.0",
  "description": "Adaptive Engineering CLI for GitHub Copilot",
  "homepage": "https://github.com/noodlemind/prompt-library",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ae": "./bin/ae.mjs"
  },
  "files": [
    "bin",
    "lib",
    "config",
    "corpus",
    "vscode-extension",
    "retired.json",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "scripts/check-release.mjs"
  ],
  "//bundledDependencies": "All hard runtime dependencies ship inside the tarball for offline installation and diagram rendering. Pinned Pele and D2/WASM need no separate executable, service or download. Pinned Tree-sitter loader/runtime and selected grammar WASM assets ship under lib/repo-map/vendor with upstream licenses and integrity manifests; no native bindings or optional package installation is required. Bundled dependency updates require an AE release and license/advisory review.",
  "scripts": {
    "check:release": "node ./scripts/check-release.mjs",
    "check:repo": "node --test ./test/release-version.test.mjs ./test/prompt-library-contracts.test.mjs",
    "preversion": "npm run check:release",
    "version": "npm run check:release",
    "prepack": "npm run check:release",
    "doctor": "node ./bin/ae.mjs doctor",
    "install:local": "node ./bin/ae.mjs install --configure-vscode --configure-path",
    "install:global": "npm install -g .",
    "test": "node ./test/run.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlemind/prompt-library.git",
    "directory": "packages/ae"
  },
  "dependencies": {
    "@d2lang/d2": "0.1.34",
    "pele": "1.8.0",
    "yaml": "^2.9.0"
  },
  "bundledDependencies": [
    "@d2lang/d2",
    "pele",
    "yaml"
  ],
  "keywords": [
    "github-copilot",
    "agent-skills",
    "adaptive-engineer",
    "harness"
  ]
}
